{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/the-story-so-far", "destination": "/#story", "permanent": true },
    { "source": "/tik-tok-channel", "destination": "https://www.tiktok.com/@thefatmechanic", "permanent": true },
    { "source": "/merch-store", "destination": "/#merch", "permanent": true },
    { "source": "/shop", "destination": "/#merch", "permanent": true },
    { "source": "/shop/:path*", "destination": "/#merch", "permanent": true },
    { "source": "/product/:path*", "destination": "/#merch", "permanent": true },
    { "source": "/my-cart", "destination": "/#merch", "permanent": true },
    { "source": "/checkout", "destination": "/#merch", "permanent": true },
    { "source": "/my-account", "destination": "/", "permanent": true },
    { "source": "/my-brands", "destination": "/", "permanent": true },
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": false },
    { "source": "/wp-login.php", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]}
  ]
}
